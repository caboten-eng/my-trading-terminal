name: Japan MA200 Recovery Screener
on:
  workflow_dispatch:
  schedule:
    # Weekdays 19:30 JST (10:30 UTC); Japan cash market already closed.
    - cron: '30 10 * * 1-5'
permissions:
  contents: write
concurrency:
  group: jp-ma200-recovery
  cancel-in-progress: false
jobs:
  screen-ma200:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yfinance pandas numpy openpyxl
      - name: Run MA200 recovery scan
        run: python screener_ma200_jp.py
      - name: Publish independent results
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add results/ma200_jp.json results/ma200_jp.csv
          if git diff --cached --quiet; then exit 0; fi
          git commit -m "Update JP MA200 recovery screening"
          git pull --rebase origin main
          git push origin HEAD:main
